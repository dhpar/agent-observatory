{
  "name": "agent-observatory",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "pnpm -r --stream run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "build": "pnpm --filter @observatory/dashboard build",
    "dev:server": "tsx watch packages/server/src/index.ts",
    "dev:dashboard": "pnpm --filter @observatory/dashboard dev",
    "hello": "tsx apps/playground/scripts/hello-run.ts",
    "observatory": "tsx packages/sdk/src/cli.ts"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.72.1"
  }
}
